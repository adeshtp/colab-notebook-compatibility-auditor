# Template for local configuration. Copy to .env and fill in, or just export the
# variables in your shell instead.
#
# IMPORTANT: this project does NOT read .env automatically. There is no
# dotenv loader in the application. Use one of these instead:
#
#   export GROQ_API_KEY=...            # shell
#   .streamlit/secrets.toml            # Streamlit, recommended for deployment
#
# .env is ignored by git. Never commit a real key.

# Required only for the AI explanation step. The deterministic audit and the
# evidence retrieval both run without it.
GROQ_API_KEY=

# Optional: switch the explanation provider. Only 'groq' and 'ollama' are supported.
# COLABAUDIT_LLM_PROVIDER=groq

# Optional: override the model. The defaults are the models selected by the
# measured provider comparison in AI_PROVIDER.md.
# COLABAUDIT_LLM_MODEL=openai/gpt-oss-20b

# Optional: base URL for the offline Ollama mode.
# COLABAUDIT_OLLAMA_HOST=http://localhost:11434